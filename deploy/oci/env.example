# /srv/matins/env on the VM — chmod 600, never in the repo.
#
# Required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means every stored upstream token and webhook secret becomes
# unreadable, and every user has to re-onboard.
ENCRYPTION_KEY=

# Multi-tenant mode: users get their own catalogue secret at /start.
# Free signup is the friends-and-family switch; remove it and configure Stripe
# to gate signups instead.
ALLOW_FREE_SIGNUP=1
BASE_URL=https://mynews.ink

# Enough for a handful of readers and their devices behind one NAT.
RATE_LIMIT_FEED_PER_MIN=120
RATE_LIMIT_SIGNUP_PER_HOUR=20

# Issue composition.
ISSUE_WINDOW_HOURS=24
ISSUE_MAX_ARTICLES=15
ISSUE_MAX_PER_FEED=4
ISSUE_MAX_WORDS=12000
ISSUE_RETENTION=14
DEFAULT_ISSUE_SCHEDULE=07:00
DEFAULT_ISSUE_TIMEZONE=Europe/Paris

# Notification email (link only, no attachment). Optional; leave unset to
# disable email and rely on webhooks.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=matins@nilleb.co
#SMTP_TLS=starttls

# /admin/issues/run — set to a long random value and keep it out of URLs in
# shared logs. Unset disables the endpoint entirely (404).
#ADMIN_TOKEN=

# Webhooks are refused for private addresses unless this is set. Keep it off on
# a public instance; turn it on only if you point webhooks at your own LAN.
#WEBHOOK_ALLOW_PRIVATE=0
# Queued articles per issue (also a per-catalogue setting), and when a recap prints.
ISSUE_MAX_SAVED=10
ISSUE_RECAP_MIN_WORDS=4000

# Server-side Listen keeps every paragraph it reads aloud on the data volume
# (/data/speech, oldest dropped past SPEECH_CACHE_MAX_MB, default 2048) and, with
# this set, in object storage: an OCI pre-authenticated request URL ending in /o/
# (terraform output -raw matins_speech_store_url in oci-freetier). Secret.
#SPEECH_STORE_URL=
#SPEECH_CACHE_MAX_MB=2048
# Who the server reads aloud for (emails linked to catalogues, comma-separated).
# Nobody else is offered the server engine.
#SPEECH_USERS=you@example.com
